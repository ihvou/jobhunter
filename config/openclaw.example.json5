// Docker gateway example. Copy relevant sections into the OpenClaw config stored
// in the openclaw_home Docker volume after running:
//   ./bin/openclaw onboard
// Validate with:
//   ./bin/openclaw config
// Cron job definitions are installed through `./bin/openclaw cron-install`
// because OpenClaw 2026.5.7 stores cron jobs via the gateway cron CLI, not
// declarative `cron.jobs` config.
//
// Phase 1.5 keeps the gateway itself in Docker, so per-agent sandboxing is off:
// mounting /var/run/docker.sock into the gateway is explicitly forbidden.
// Safety is enforced by narrow mounts, no shell exec, deny-lists, and bounded
// Jobhunter dynamic tools.
// Run './bin/openclaw onboard' to apply this config.
{
  channels: {
    telegram: {
      enabled: true,
      botToken: "${TELEGRAM_BOT_TOKEN}",
      dmPolicy: "allowlist",
      allowFrom: ["tg:${TELEGRAM_ALLOWED_CHAT_ID}"],
      capabilities: {
        inlineButtons: "dm",
      },
      actions: {
        sendMessage: true,
        editMessage: true,
        deleteMessage: true,
      },
      customCommands: [
        { command: "jobs",    description: "Get fresh ranked jobs digest" },
        { command: "leads",   description: "Get fresh ranked leads digest" },
        { command: "sources", description: "Propose source changes for approval" },
        { command: "scoring", description: "Propose scoring rule changes" },
        { command: "usage",   description: "Show spend, quota, recent activity" },
      ],
    },
  },
  skills: {
    load: {
      extraDirs: ["/openclaw/skills"],
    },
  },
  cron: {
    enabled: true,
    maxConcurrentRuns: 1,
  },
  agents: {
    defaults: {
      agentRuntime: {
        id: "codex",
      },
      model: {
        primary: "openai-codex/gpt-5.5",
      },
      models: {
        "openai-codex/gpt-5.5": {},
        "codex-cli/gpt-5.5": {},
      },
      // OpenClaw 2026.5.7 resolves CLI backend config from
      // agents.defaults.cliBackends, not agents.list[].cliBackends. Regular
      // agents stay on openai-codex app-server; only Engineer selects the
      // codex-cli model below, so this backend is effectively Engineer-scoped.
      // The OpenAI plugin owns codex-cli bundleMcp/native-tool registration;
      // this override changes only command/env/args so Engineer still receives
      // Jobhunter plugin tools via OpenClaw's generated Codex MCP overlay.
      cliBackends: {
        "codex-cli": {
          command: "/home/node/.openclaw/npm/node_modules/@openai/codex/bin/codex.js",
          env: {
            CODEX_HOME: "/home/node/.openclaw/agents/engineer/agent/codex-home",
            HOME: "/home/node/.openclaw/agents/engineer/agent",
          },
          args: [
            "exec",
            "--json",
            "--color",
            "never",
            "--sandbox",
            "workspace-write",
            "--cd",
            "/workspace",
            "-c",
            "approval_policy=\"never\"",
            "-c",
            "service_tier=\"fast\"",
            "--skip-git-repo-check",
          ],
          resumeArgs: [
            "exec",
            "resume",
            "{sessionId}",
            "-c",
            "sandbox_mode=\"workspace-write\"",
            "-c",
            "approval_policy=\"never\"",
            "-c",
            "service_tier=\"fast\"",
            "--skip-git-repo-check",
          ],
          output: "jsonl",
          resumeOutput: "text",
          input: "arg",
          modelArg: "--model",
          sessionIdFields: ["thread_id"],
          sessionMode: "existing",
        },
      },
      skills: ["jobhunter"],
      sandbox: {
        mode: "off",
      },
    },
    list: [
      {
        id: "jobs",
        name: "Jobhunter",
        skills: ["jobhunter"],
      },
      {
        id: "leads",
        name: "Leadhunter",
        skills: ["leadhunter"],
      },
      {
        id: "collector",
        name: "Jobhunter Collector",
        skills: ["data-collector"],
      },
      {
        id: "qa",
        name: "Jobhunter QA",
        skills: ["qa"],
      },
      {
        id: "pm",
        name: "Jobhunter PM",
        skills: ["pm"],
      },
      {
        id: "researcher",
        name: "Jobhunter Researcher",
        skills: ["researcher"],
      },
      {
        id: "engineer",
        name: "Jobhunter Engineer",
        skills: ["engineer"],
        agentRuntime: { id: "codex-cli" },
        model: { primary: "codex-cli/gpt-5.5" },
        agentDir: "/home/node/.openclaw/agents/engineer/agent",
        workspace: "/workspace",
        tools: {
          profile: "coding",
          alsoAllow: ["jobhunter-tools", "web_search", "web_fetch", "firecrawl", "exa"],
          deny: ["group:automation"],
          exec: {
            host: "gateway",
            security: "allowlist",
            ask: "always",
            safeBins: ["git", "gh", "python3", "node", "npm"],
            timeoutSec: 1200,
            applyPatch: { enabled: true, workspaceOnly: true },
          },
          fs: { workspaceOnly: true },
          elevated: { enabled: false },
        },
        sandbox: { mode: "off", workspaceAccess: "rw", workspaceRoot: "/workspace" },
      },
    ],
  },
  plugins: {
    allow: ["codex", "telegram", "jobhunter-tools", "firecrawl", "exa", "memory-core", "openai"],
    load: {
      // Dynamic Jobhunter tools are the sole Jobhunter tool surface. Do not
      // register a duplicate mcp.servers.jobhunter entry.
      paths: ["/opt/jobhunter/plugins/jobhunter-tools"],
    },
    entries: {
      codex: {
        enabled: true,
        config: {
          codexDynamicToolsProfile: "native-first",
          codexDynamicToolsExclude: [],
          appServer: {
            approvalPolicy: "on-request",
            sandbox: "read-only",
            serviceTier: "fast",
          },
        },
      },
      "jobhunter-tools": {
        enabled: true,
      },
      telegram: {
        enabled: true,
      },
      "memory-core": {
        enabled: true,
      },
      openai: {
        enabled: true,
      },
      firecrawl: {
        enabled: true,
        config: {
          webFetch: {
            onlyMainContent: true,
            maxAgeMs: 86400000,
            timeoutSeconds: 30,
          },
          webSearch: {
            baseUrl: "https://api.firecrawl.dev",
          },
        },
      },
      exa: {
        enabled: true,
        config: {
          webSearch: {
            baseUrl: "https://api.exa.ai",
          },
        },
      },
    },
  },
  tools: {
    profile: "messaging",
    alsoAllow: ["web_search", "web_fetch", "jobhunter-tools", "firecrawl", "exa"],
    deny: ["group:runtime", "group:fs", "group:automation"],
    web: {
      fetch: {
        provider: "firecrawl",
      },
    },
    fs: {
      workspaceOnly: true,
    },
    exec: {
      security: "deny",
      ask: "always",
    },
    elevated: {
      enabled: false,
    },
  },
}
