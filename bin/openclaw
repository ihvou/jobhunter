#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
COMPOSE=(docker compose --project-directory "$ROOT" --file "$ROOT/docker-compose.yml")
SERVICE_URL="${JOBHUNTER_SERVICE_URL:-http://127.0.0.1:8765}"
GATEWAY_URL="${OPENCLAW_GATEWAY_URL:-http://127.0.0.1:18789}"
DRY_RUN="${OPENCLAW_DRY_RUN:-0}"

usage() {
  cat <<'EOF'
Usage: ./bin/openclaw <command>

Commands:
  start     Build and start jobhunter-service + openclaw-gateway
  stop      Stop jobhunter-service + openclaw-gateway
  restart   Recreate jobhunter-service + openclaw-gateway
  logs      Follow both logs; use "logs gateway" or "logs service"
  status    Show service and gateway status
  shell     Open a shell; use "shell gateway" or "shell service"
  onboard   Run Dockerized OpenClaw onboarding without host daemon install
  set-keyboard  Apply the persistent Telegram 2x2 reply keyboard
  reset-sessions  Clear cached Telegram direct sessions for fresh tool prompts
  set-thinking [<level>]  Set Codex model_reasoning_effort across all agents (default: high)
  ensure-engineer-workspace  Prepare /workspace clone and Engineer Codex sandbox
  engineer-codex-status  Check Engineer's private Codex CLI login status
  engineer-codex-login [--reset]  Fresh device login for Engineer's private Codex CLI auth
  watchdog [--auto]  Detect Telegram sessions wedged in "processing" state and (with --auto) reset them
  cron-install  Register the OpenClaw cron jobs
  cron-list     List OpenClaw cron jobs
  doctor    Run OpenClaw doctor inside the gateway image
  migrate-codex  Run OpenClaw Codex auth migration inside the gateway image
  config    Print suggested OpenClaw config snippet
  help      Show this help
EOF
}

ENGINEER_HOME="/home/node/.openclaw/agents/engineer/agent"
ENGINEER_CODEX_HOME="$ENGINEER_HOME/codex-home"
CODEX_BIN="/home/node/.openclaw/npm/node_modules/@openai/codex/bin/codex.js"

run_cmd() {
  if [ "$DRY_RUN" = "1" ]; then
    printf '+'
    printf ' %q' "$@"
    printf '\n'
  else
    "$@"
  fi
}

service_health() {
  local health
  health="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' jobhunter-service 2>/dev/null || true)"
  case "$health" in
    healthy|running) printf "ok\n" ;;
    starting) printf "starting\n" ;;
    unhealthy|exited|dead) printf "bad\n" ;;
    *) printf "down\n" ;;
  esac
}

gateway_health() {
  python3 - "$GATEWAY_URL" <<'PY'
import sys
import urllib.request

try:
    with urllib.request.urlopen(sys.argv[1].rstrip("/") + "/health", timeout=2) as response:
        print("ok" if 200 <= response.status < 300 else "bad")
except Exception:
    print("down")
PY
}

wait_gateway_health() {
  local attempt status
  for attempt in $(seq 1 60); do
    status="$(gateway_health)"
    if [ "$status" = "ok" ]; then
      printf "openclaw-gateway health: ok\n"
      return 0
    fi
    sleep 2
  done
  printf "openclaw-gateway health: %s after restart timeout\n" "$status" >&2
  return 1
}

container_state() {
  docker inspect -f '{{.State.Status}}' "$1" 2>/dev/null || printf missing
}

gateway_node() {
  run_cmd "${COMPOSE[@]}" run --rm --no-deps --entrypoint node openclaw-gateway dist/index.js "$@"
}

gateway_node_live() {
  run_cmd "${COMPOSE[@]}" exec -T openclaw-gateway node /app/dist/index.js "$@"
}

set_keyboard() {
  if [ "$DRY_RUN" = "1" ]; then
    printf '+ docker exec -i openclaw-gateway sh -c %q < set-keyboard-node-script\n' 'node -'
    return 0
  fi
  docker exec -i openclaw-gateway sh -c 'node -' <<'NODE'
const https = require("node:https");

const token = process.env.TELEGRAM_BOT_TOKEN || "";
const chatId = process.env.TELEGRAM_ALLOWED_CHAT_ID || "";
if (!token) {
  console.error("missing TELEGRAM_BOT_TOKEN in openclaw-gateway env");
  process.exit(2);
}
if (!chatId) {
  console.error("missing TELEGRAM_ALLOWED_CHAT_ID in openclaw-gateway env");
  process.exit(2);
}

const payload = JSON.stringify({
  chat_id: chatId,
  text: "Menu updated.",
  reply_markup: {
    keyboard: [
      ["Get more jobs", "My job profile"],
      ["Get more leads", "My ICP profile"],
    ],
    resize_keyboard: true,
    is_persistent: true,
  },
});

const request = https.request(
  {
    hostname: "api.telegram.org",
    path: `/bot${token}/sendMessage`,
    method: "POST",
    headers: {
      "content-type": "application/json",
      "content-length": Buffer.byteLength(payload),
    },
  },
  (response) => {
    let body = "";
    response.setEncoding("utf8");
    response.on("data", (chunk) => {
      body += chunk;
    });
    response.on("end", () => {
      let parsed = {};
      try {
        parsed = JSON.parse(body || "{}");
      } catch {
        console.error(`telegram set-keyboard returned non-JSON HTTP ${response.statusCode}: ${body.slice(0, 300)}`);
        process.exit(1);
      }
      if (!parsed.ok) {
        console.error(`telegram set-keyboard failed: ${parsed.description || body.slice(0, 300)}`);
        process.exit(1);
      }
      console.log(`keyboard set: message_id=${parsed.result && parsed.result.message_id}`);
    });
  },
);

request.on("error", (error) => {
  console.error(`telegram set-keyboard request failed: ${error.message}`);
  process.exit(1);
});
request.end(payload);
NODE
}

reset_sessions() {
  local chat_id=""
  case "${1:-}" in
    "")
      ;;
    --chat)
      if [ -z "${2:-}" ]; then
        printf "reset-sessions: --chat requires a chat id\n" >&2
        return 2
      fi
      chat_id="$2"
      ;;
    *)
      printf "reset-sessions: unknown argument: %s\n" "$1" >&2
      printf "usage: ./bin/openclaw reset-sessions [--chat <chat_id>]\n" >&2
      return 2
      ;;
  esac
  if [ "$DRY_RUN" = "1" ]; then
    printf '+ docker exec -i openclaw-gateway sh -c %q sh %q < reset-sessions-node-script\n' 'node - "$1"' "$chat_id"
    printf '+'
    printf ' %q' "${COMPOSE[@]}" restart openclaw-gateway
    printf '\n'
    return 0
  fi
  docker exec -i openclaw-gateway sh -c 'node - "$1"' sh "$chat_id" <<'NODE'
const fs = require("node:fs");

// Walk every agent's sessions.json (jobs, main, future leads/qa/pm/researcher/engineer).
// Older versions of this script only touched agent:jobs:* and silently missed
// agent:main:telegram:direct:* entries, leaving sessions wedged across restarts.
const chatId = process.argv[2] || "";
const agentsRoot = "/home/node/.openclaw/agents";
const removed = [];

if (!fs.existsSync(agentsRoot)) {
  console.log("removed session keys: none (agents dir absent)");
  process.exit(0);
}

for (const agent of fs.readdirSync(agentsRoot)) {
  const sessionsPath = `${agentsRoot}/${agent}/sessions/sessions.json`;
  if (!fs.existsSync(sessionsPath)) continue;
  let data;
  try {
    data = JSON.parse(fs.readFileSync(sessionsPath, "utf8"));
  } catch (err) {
    console.error(`skip ${sessionsPath}: ${err.message}`);
    continue;
  }
  let touched = false;
  for (const key of Object.keys(data)) {
    if (!key.includes(":telegram:direct:")) continue;
    const chatPart = key.split(":").pop();
    if (chatId && chatPart !== chatId) continue;
    removed.push(`${agent}::${key}`);
    delete data[key];
    touched = true;
  }
  if (touched) {
    const tmp = `${sessionsPath}.tmp`;
    fs.writeFileSync(tmp, `${JSON.stringify(data, null, 2)}\n`);
    fs.renameSync(tmp, sessionsPath);
  }
}

if (removed.length) {
  console.log(`removed session keys: ${removed.join(", ")}`);
} else {
  console.log("removed session keys: none");
}
NODE
  run_cmd "${COMPOSE[@]}" restart openclaw-gateway >/dev/null
  wait_gateway_health
}

set_thinking() {
  local level="${1:-high}"
  case "$level" in
    minimal|low|medium|high|xhigh|max) ;;
    *)
      printf "set-thinking: invalid level '%s' (allowed: minimal|low|medium|high|xhigh|max)\n" "$level" >&2
      return 2
      ;;
  esac
  if [ "$DRY_RUN" = "1" ]; then
    printf '+ docker exec openclaw-gateway sh -c %q\n' \
      "for f in /home/node/.openclaw/agents/*/agent/codex-home/config.toml; do upsert model_reasoning_effort=\"$level\"; done"
    return 0
  fi
  docker exec openclaw-gateway sh -c 'level="$1"; updated=0; for f in /home/node/.openclaw/agents/*/agent/codex-home/config.toml; do
    [ -f "$f" ] || continue
    if grep -q "^model_reasoning_effort" "$f"; then
      sed -i "s/^model_reasoning_effort.*/model_reasoning_effort = \"$level\"/" "$f"
    else
      printf "\nmodel_reasoning_effort = \"%s\"\n" "$level" >> "$f"
    fi
    printf "set: %s -> %s\n" "$f" "$level"
    updated=$((updated + 1))
  done
  if [ "$updated" = 0 ]; then
    echo "set-thinking: no agent codex-home config files found (run start/onboard first)" >&2
    exit 3
  fi' sh "$level"
}

read_github_pat() {
  if [ -n "${GITHUB_PAT:-}" ]; then
    printf "%s" "$GITHUB_PAT"
    return 0
  fi
  if [ ! -f "$ROOT/.env" ]; then
    return 0
  fi
  python3 - "$ROOT/.env" <<'PY'
import shlex
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as handle:
    for raw in handle:
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[7:].lstrip()
        if not line.startswith("GITHUB_PAT="):
            continue
        value = line.split("=", 1)[1].strip()
        if not value:
            break
        try:
            parts = shlex.split(value, comments=False, posix=True)
        except ValueError:
            parts = []
        print(parts[0] if parts else value.strip("\"'"))
        break
PY
}

ensure_engineer_workspace() {
  if [ "$DRY_RUN" = "1" ]; then
    printf '+ docker run --rm -v %s:/workspace busybox sh -c %q\n' 'jobhunter_engineer_workspace' 'chown -R 1000:1000 /workspace'
    printf '+ docker exec -i openclaw-gateway sh -c %q < ensure-engineer-workspace-script\n' 'sh -s'
    return 0
  fi
  local github_pat
  local docker_exec=(docker exec -i)
  github_pat="$(read_github_pat)"
  # Gateway runs with cap_drop: ALL, so even -u root can't chown a fresh named volume.
  # Use a one-shot helper container (no cap_drop) to set ownership to node (uid 1000) once.
  docker run --rm -v jobhunter_engineer_workspace:/workspace busybox sh -c 'chown -R 1000:1000 /workspace'
  if [ -n "$github_pat" ]; then
    docker_exec+=(-e "GITHUB_PAT=$github_pat")
  fi
  docker_exec+=(openclaw-gateway sh -s)
  "${docker_exec[@]}" <<'SH'
set -eu
workspace=/workspace
repo_ro=/opt/jobhunter
remote_url="$(git -C "$repo_ro" config --get remote.origin.url 2>/dev/null || printf '%s' 'https://github.com/ihvou/jobhunter.git')"

mkdir -p "$workspace"
if [ ! -d "$workspace/.git" ]; then
  rmdir "$workspace" 2>/dev/null || true
  if ! git clone "$remote_url" "$workspace"; then
    git clone "$repo_ro" "$workspace"
    git -C "$workspace" remote set-url origin "$remote_url" || true
  fi
else
  git -C "$workspace" remote set-url origin "$remote_url" || true
  git -C "$workspace" fetch origin || true
  if git -C "$workspace" rev-parse --verify origin/main >/dev/null 2>&1; then
    git -C "$workspace" checkout main >/dev/null 2>&1 || git -C "$workspace" checkout -B main
    git -C "$workspace" reset --hard origin/main
  fi
fi

if [ -n "${GITHUB_PAT:-}" ]; then
  if command -v gh >/dev/null 2>&1; then
    printf '%s\n' "$GITHUB_PAT" | gh auth login --with-token >/dev/null 2>&1 || true
    gh auth setup-git >/dev/null 2>&1 || true
    gh auth status || true
  else
    echo "gh CLI is not installed; Engineer can prepare workspace but cannot open PRs" >&2
  fi
else
  echo "GITHUB_PAT unset; Engineer will defer PR-needing tasks"
fi

codex_home=/home/node/.openclaw/agents/engineer/agent/codex-home
mkdir -p "$codex_home"
config="$codex_home/config.toml"
touch "$config"
# Rewrite engineer codex-home config.toml cleanly each time. Avoids the
# duplicate-key trap where regex variants (with vs without spaces around =)
# both match and append duplicates that Codex refuses to load.
cat > "$config" <<TOML
sandbox = "workspace-write"
sandbox_mode = "workspace-write"
approval_policy = "never"
model_reasoning_effort = "high"
TOML

# Bootstrap engineer Codex auth ONLY if it has none yet. Codex CLI uses
# single-use rotating refresh tokens and rotates them in place inside
# engineer's codex-home. Overwriting an existing (possibly freshly-rotated)
# auth.json with a stale copy from elsewhere breaks it with
# "refresh token already used". So we copy the host auth.json once, as a
# bootstrap seed, and never clobber an existing engineer auth.json. If
# engineer auth is genuinely dead, do a fresh `codex login` against
# CODEX_HOME=engineer/agent/codex-home (see tasks.md #157), not a re-copy.
if [ ! -f "$codex_home/auth.json" ] && [ -f /home/node/.codex/auth.json ]; then
  cp /home/node/.codex/auth.json "$codex_home/auth.json"
  chmod 600 "$codex_home/auth.json"
fi
echo "engineer workspace ready: $(git -C "$workspace" rev-parse --show-toplevel 2>/dev/null || echo "$workspace")"
SH
}

maybe_ensure_engineer_workspace() {
  if [ "$DRY_RUN" = "1" ]; then
    ensure_engineer_workspace
    return 0
  fi
  if [ -n "$(read_github_pat)" ]; then
    ensure_engineer_workspace
  else
    printf "Engineer workspace not initialized automatically because GITHUB_PAT is unset in the shell and .env. Run './bin/openclaw ensure-engineer-workspace' when ready.\n"
  fi
}

engineer_codex_prepare_home() {
  if [ "$DRY_RUN" = "1" ]; then
    printf '+ docker exec openclaw-gateway sh -c %q\n' \
      "mkdir -p \"$ENGINEER_CODEX_HOME\" \"$ENGINEER_HOME\" && touch \"$ENGINEER_CODEX_HOME/config.toml\""
    return 0
  fi
  docker exec openclaw-gateway sh -c 'set -eu
engineer_home="$1"
codex_home="$2"
mkdir -p "$engineer_home" "$codex_home"
config="$codex_home/config.toml"
touch "$config"
if ! grep -q "^model_reasoning_effort = " "$config"; then
  printf "%s\n" "model_reasoning_effort = \"high\"" >> "$config"
fi
' sh "$ENGINEER_HOME" "$ENGINEER_CODEX_HOME"
}

engineer_codex_backup_auth() {
  if [ "$DRY_RUN" = "1" ]; then
    printf '+ docker exec openclaw-gateway sh -c %q\n' \
      "if [ -f \"$ENGINEER_CODEX_HOME/auth.json\" ]; then mv \"$ENGINEER_CODEX_HOME/auth.json\" \"$ENGINEER_CODEX_HOME/auth.json.dead.\$(date -u +%Y%m%d%H%M%S)\"; fi"
    return 0
  fi
  docker exec openclaw-gateway sh -c 'set -eu
codex_home="$1"
if [ -f "$codex_home/auth.json" ]; then
  backup="$codex_home/auth.json.dead.$(date -u +%Y%m%d%H%M%S)"
  mv "$codex_home/auth.json" "$backup"
  chmod 600 "$backup" 2>/dev/null || true
  echo "engineer Codex auth backed up: $backup"
else
  echo "engineer Codex auth reset: no auth.json present"
fi
' sh "$ENGINEER_CODEX_HOME"
}

engineer_codex_exec() {
  local docker_args=(exec -i)
  if [ -t 0 ] && [ -t 1 ]; then
    docker_args=(exec -it)
  fi
  if [ "$DRY_RUN" = "1" ]; then
    printf '+ docker'
    printf ' %q' "${docker_args[@]}" -e "HOME=$ENGINEER_HOME" -e "CODEX_HOME=$ENGINEER_CODEX_HOME" openclaw-gateway "$CODEX_BIN" "$@"
    printf '\n'
    return 0
  fi
  docker "${docker_args[@]}" \
    -e "HOME=$ENGINEER_HOME" \
    -e "CODEX_HOME=$ENGINEER_CODEX_HOME" \
    openclaw-gateway "$CODEX_BIN" "$@"
}

engineer_codex_status() {
  engineer_codex_prepare_home
  if [ "$DRY_RUN" = "1" ]; then
    engineer_codex_exec login status
    return 0
  fi
  if engineer_codex_exec login status; then
    printf "engineer Codex auth: ok (%s)\n" "$ENGINEER_CODEX_HOME/auth.json"
  else
    printf "engineer Codex auth: failed. Run './bin/openclaw engineer-codex-login --reset' to create a fresh device login for Engineer.\n" >&2
    return 1
  fi
}

engineer_codex_login() {
  local reset=0
  if [ "$#" -gt 1 ]; then
    printf "usage: ./bin/openclaw engineer-codex-login [--reset]\n" >&2
    return 2
  fi
  case "${1:-}" in
    --reset)
      reset=1
      ;;
    "" )
      ;;
    * )
      printf "usage: ./bin/openclaw engineer-codex-login [--reset]\n" >&2
      return 2
      ;;
  esac
  engineer_codex_prepare_home
  if [ "$reset" = "1" ]; then
    engineer_codex_backup_auth
  fi
  printf "Starting Engineer Codex device login.\n"
  printf "This writes only to %s inside openclaw-gateway.\n" "$ENGINEER_CODEX_HOME"
  printf "It does not touch main OpenClaw app-server auth or host ~/.codex.\n"
  engineer_codex_exec login --device-auth
  printf "Engineer Codex login finished. Checking status...\n"
  engineer_codex_status
}

watchdog() {
  # Detect Telegram direct sessions where the trajectory file hasn't been written
  # for WATCHDOG_STALE_SECONDS (default 21600 = 6h). OpenClaw 2026.5.7 occasionally
  # leaves sessions stuck in "processing" with last=embedded_run:ended for many
  # hours after the underlying Codex turn ended cleanly. Queued user messages
  # then pile up behind the phantom-active session and never dispatch. The fix is
  # the same delete-from-sessions.json + restart that ./bin/openclaw reset-sessions
  # already does; this just automates the detection.
  local auto_mode=""
  local stale_threshold="${WATCHDOG_STALE_SECONDS:-21600}"
  case "${1:-}" in
    "") ;;
    --auto) auto_mode=1 ;;
    *)
      printf "watchdog: unknown arg '%s' (allowed: --auto)\n" "$1" >&2
      return 2
      ;;
  esac
  if [ "$DRY_RUN" = "1" ]; then
    printf '+ docker exec openclaw-gateway python3 watchdog-scan (threshold=%ss, auto=%s)\n' "$stale_threshold" "${auto_mode:-0}"
    return 0
  fi
  local scan_output
  scan_output="$(docker exec -i openclaw-gateway python3 - "$stale_threshold" <<'PY'
import glob, json, os, sys, time
threshold = int(sys.argv[1])
now = time.time()
# Walk every agent's sessions.json so we don't lock the watchdog to a single
# agent id; today only the jobs agent exists, Phase 7 will add more.
for sessions_path in glob.glob('/home/node/.openclaw/agents/*/sessions/sessions.json'):
    try:
        with open(sessions_path) as f:
            sessions = json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        continue
    for key, sess in sessions.items():
        if ':telegram:direct:' not in key:
            continue
        chat_id = key.rsplit(':', 1)[-1]
        session_file = sess.get('sessionFile', '')
        if not session_file:
            continue
        traj = session_file.replace('.jsonl', '.trajectory.jsonl')
        if not os.path.exists(traj):
            continue
        age = int(now - os.path.getmtime(traj))
        if age > threshold:
            print(f"{chat_id}\t{age}")
PY
)" || true
  if [ -z "$scan_output" ]; then
    printf "watchdog: 0 stale sessions (threshold=%ss)\n" "$stale_threshold"
    return 0
  fi
  local stale_count
  stale_count="$(printf "%s\n" "$scan_output" | grep -c '^')"
  printf "watchdog: %s stale Telegram session(s) detected (threshold=%ss):\n" "$stale_count" "$stale_threshold"
  printf "%s\n" "$scan_output" | while IFS=$'\t' read -r chat_id age; do
    [ -n "$chat_id" ] || continue
    printf "  chat=%s age=%ss (%sh)\n" "$chat_id" "$age" "$((age / 3600))"
  done
  if [ -z "$auto_mode" ]; then
    printf "(rerun with --auto to reset; or set WATCHDOG_STALE_SECONDS=<seconds> to adjust threshold)\n"
    return 0
  fi
  # Reset each. Each reset_sessions call restarts the gateway, so multiple stale
  # chats means multiple restarts — fine in practice because stale-pile-ups are rare.
  printf "%s\n" "$scan_output" | while IFS=$'\t' read -r chat_id age; do
    [ -n "$chat_id" ] || continue
    printf "watchdog: auto-resetting chat=%s (age=%ss)\n" "$chat_id" "$age"
    reset_sessions --chat "$chat_id"
  done
}

config_patch() {
  local payload="$1"
  if [ "$DRY_RUN" = "1" ]; then
    printf '+'
    printf ' %q' "${COMPOSE[@]}" exec -T openclaw-gateway node /app/dist/index.js config patch --stdin
    printf ' <<< %q\n' "$payload"
  else
    printf '%s\n' "$payload" | "${COMPOSE[@]}" exec -T openclaw-gateway node /app/dist/index.js config patch --stdin
  fi
}

patch_jobhunter_openclaw_config() {
  local payload
  payload="$(cat <<'JSON'
{
  "channels": {
    "telegram": {
      "capabilities": { "inlineButtons": "dm" },
      "actions": { "sendMessage": true, "editMessage": true, "deleteMessage": true },
      "customCommands": [
        { "command": "jobs",    "description": "Get fresh ranked jobs digest" },
        { "command": "leads",   "description": "Get fresh ranked leads digest" },
        { "command": "sources", "description": "Propose source changes for approval" },
        { "command": "scoring", "description": "Propose scoring rule changes" },
        { "command": "usage",   "description": "Show spend, quota, recent activity" }
      ]
    }
  },
  "cron": {
    "enabled": true,
    "maxConcurrentRuns": 1
  },
  "mcp": { "servers": { "jobhunter": null } },
  "skills": { "load": { "extraDirs": ["/openclaw/skills"] } },
  "agents": {
    "defaults": {
      "agentRuntime": { "id": "codex" },
      "model": { "primary": "openai-codex/gpt-5.5" },
      "models": {
        "openai-codex/gpt-5.5": {},
        "codex-cli/gpt-5.5": {}
      },
      "cliBackends": {
        "codex-cli": {
          "command": "/home/node/.openclaw/npm/node_modules/@openai/codex/bin/codex.js",
          "env": {
            "CODEX_HOME": "/home/node/.openclaw/agents/engineer/agent/codex-home",
            "HOME": "/home/node/.openclaw/agents/engineer/agent"
          },
          "args": [
            "exec",
            "--json",
            "--color",
            "never",
            "--dangerously-bypass-approvals-and-sandbox",
            "--cd",
            "/workspace",
            "-c",
            "approval_policy=\"never\"",
            "-c",
            "service_tier=\"fast\"",
            "--skip-git-repo-check"
          ],
          "resumeArgs": [
            "exec",
            "resume",
            "{sessionId}",
            "--dangerously-bypass-approvals-and-sandbox",
            "-c",
            "approval_policy=\"never\"",
            "-c",
            "service_tier=\"fast\"",
            "--skip-git-repo-check"
          ],
          "output": "jsonl",
          "resumeOutput": "text",
          "input": "arg",
          "modelArg": "--model",
