        }
      },
      "skills": ["jobhunter"],
      "sandbox": { "mode": "off" }
    },
    "list": [
      { "id": "jobs", "name": "Jobhunter", "skills": ["jobhunter"] },
      { "id": "leads", "name": "Leadhunter", "skills": ["leadhunter"] },
      { "id": "collector", "name": "Jobhunter Collector", "skills": ["data-collector"] },
      { "id": "qa", "name": "Jobhunter QA", "skills": ["qa"] },
      { "id": "pm", "name": "Jobhunter PM", "skills": ["pm"] },
      { "id": "researcher", "name": "Jobhunter Researcher", "skills": ["researcher"] },
      {
        "id": "engineer",
        "name": "Jobhunter Engineer",
        "skills": ["engineer"],
        "agentRuntime": { "id": "codex-cli" },
        "model": { "primary": "codex-cli/gpt-5.5" },
        "agentDir": "/home/node/.openclaw/agents/engineer/agent",
        "workspace": "/workspace",
        "tools": {
          "profile": "coding",
          "alsoAllow": ["jobhunter-tools", "web_search", "web_fetch", "firecrawl", "exa"],
          "deny": ["group:automation"],
          "exec": {
            "host": "gateway",
            "security": "allowlist",
            "ask": "always",
            "safeBins": ["git", "gh", "python3", "node", "npm"],
            "timeoutSec": 1200,
            "applyPatch": { "enabled": true, "workspaceOnly": true }
          },
          "fs": { "workspaceOnly": true },
          "elevated": { "enabled": false }
        },
        "sandbox": { "mode": "off", "workspaceAccess": "rw", "workspaceRoot": "/workspace" }
      }
    ]
  },
  "plugins": {
    "allow": ["codex", "telegram", "jobhunter-tools", "firecrawl", "exa", "memory-core", "openai"],
    "load": { "paths": ["/opt/jobhunter/plugins/jobhunter-tools"] },
    "entries": {
      "codex": {
        "enabled": true,
        "config": {
          "codexDynamicToolsProfile": "native-first",
          "codexDynamicToolsExclude": [],
          "appServer": {
            "approvalPolicy": "on-request",
            "sandbox": "read-only",
            "serviceTier": "fast"
          }
        }
      },
      "telegram": { "enabled": true },
      "memory-core": { "enabled": true },
      "openai": { "enabled": true },
      "firecrawl": {
        "enabled": true,
        "config": {
          "webFetch": {
            "onlyMainContent": true,
            "maxAgeMs": 86400000,
            "timeoutSeconds": 30
          },
          "webSearch": { "baseUrl": "https://api.firecrawl.dev" }
        }
      },
      "exa": {
        "enabled": true,
        "config": { "webSearch": { "baseUrl": "https://api.exa.ai" } }
      },
      "jobhunter-tools": { "enabled": true },
      "jobhunter-mcp": null
    }
  },
  "tools": {
    "profile": "messaging",
    "alsoAllow": ["web_search", "web_fetch", "jobhunter-tools", "firecrawl", "exa"],
    "deny": ["group:runtime", "group:fs", "group:automation"],
    "web": { "fetch": { "provider": "firecrawl" } },
    "fs": { "workspaceOnly": true },
    "exec": { "security": "deny", "ask": "always" },
    "elevated": { "enabled": false }
  }
}
JSON
)"
  config_patch "$payload"
}

remove_codex_mcp_jobhunter() {
  local cmd=(env HOME=/home/node/.openclaw/agents/main/agent/codex-home /home/node/.openclaw/npm/node_modules/@openai/codex/bin/codex.js mcp remove jobhunter)
  if [ "$DRY_RUN" = "1" ]; then
    printf '+'
    printf ' %q' "${COMPOSE[@]}" exec -T openclaw-gateway "${cmd[@]}"
    printf '\n'
  else
    "${COMPOSE[@]}" exec -T openclaw-gateway "${cmd[@]}" || true
  fi
}

cron_exec() {
  if [ "$DRY_RUN" = "1" ]; then
    printf '+'
    printf ' %q' "${COMPOSE[@]}" exec -T openclaw-gateway node /app/dist/index.js cron "$@"
    printf '\n'
  else
    "${COMPOSE[@]}" exec -T openclaw-gateway node /app/dist/index.js cron "$@"
  fi
}

cron_upsert_agent_job() {
  local name="$1"
  local schedule="$2"
  local agent="$3"
  local timeout_seconds="$4"
  local deliver="$5"
  local message="$6"
  if [ "$DRY_RUN" = "1" ]; then
    cron_exec rm "$name"
    cron_exec add --name "$name" --cron "$schedule" --agent "$agent" --session isolated --light-context --timeout-seconds "$timeout_seconds" --message "$message" --no-deliver --json
    return
  fi
  # `cron rm` takes an id, not a name. Resolve all existing entries by name
  # and remove each so re-installs don't accumulate duplicates.
  "${COMPOSE[@]}" exec -T openclaw-gateway sh -c '
    set -eu
    node /app/dist/index.js cron list 2>/dev/null \
      | awk -v target="$1" '"'"'NR>1 && $2==target {print $1}'"'"' \
      | while read -r id; do
          [ -n "$id" ] && node /app/dist/index.js cron rm "$id" >/dev/null 2>&1 || true
        done
  ' sh "$name" >/dev/null 2>&1 || true
  if [ "$deliver" = "telegram" ]; then
    "${COMPOSE[@]}" exec -T openclaw-gateway sh -c '
      set -eu
      if [ -n "${TELEGRAM_ALLOWED_CHAT_ID:-}" ]; then
        exec node /app/dist/index.js cron add \
          --name "$1" --cron "$2" --agent "$3" --session isolated --light-context \
          --timeout-seconds "$4" --message "$5" \
          --announce --best-effort-deliver --channel telegram --to "$TELEGRAM_ALLOWED_CHAT_ID" --json
      fi
      exec node /app/dist/index.js cron add \
        --name "$1" --cron "$2" --agent "$3" --session isolated --light-context \
        --timeout-seconds "$4" --message "$5" --no-deliver --json
    ' sh "$name" "$schedule" "$agent" "$timeout_seconds" "$message"
  else
    "${COMPOSE[@]}" exec -T openclaw-gateway node /app/dist/index.js cron add \
      --name "$name" --cron "$schedule" --agent "$agent" --session isolated --light-context \
      --timeout-seconds "$timeout_seconds" --message "$message" --no-deliver --json
  fi
}

install_cron_jobs() {
  # Phase 7 retired three pre-Phase-7 crons. Remove them on every install so
  # upgrading users don't leave orphan crons firing against retired flows.
  # Safe to call when the crons don't exist — `cron rm` is no-op in that case.
  for stale in jobs-rescore-on-feedback-change email-audit-nightly jobs-discovery-monthly; do
    cron_exec rm "$stale" 2>/dev/null || true
  done
  cron_upsert_agent_job \
    "jobs-collection" \
    "0 */4 * * *" \
    "collector" \
    "900" \
    "none" \
    "Collector routine: call jobhunter_collect_all_sources, process unparsed emails if needed, call jobhunter_get_more_jobs with mark_sent=false to verify counts, complete at most one collector task, then write jobhunter_write_status_report. Do not render job cards unless a human asked."
  # Cron expressions are interpreted in UTC by the gateway. The schedules below
  # are calibrated for WITA (UTC+8) overnight: subtract 8h from the desired local
  # time to get the UTC cron expression.
  #   researcher-nightly  03:00 WITA = 19:00 UTC
  #   engineer-nightly    04:00 WITA = 20:00 UTC
  #   qa-nightly          05:30 WITA = 21:30 UTC
  #   pm-stakeholder      06:30 WITA = 22:30 UTC
  cron_upsert_agent_job \
    "researcher-nightly" \
    "0 19 * * *" \
    "researcher" \
    "1800" \
    "none" \
    "Researcher routine: read research context/profile/ICP/tasks, validate one angle with bounded public web/firecrawl/exa search, file exactly one concrete task or complete a picked task, write jobhunter_write_status_report, and stay silent on Telegram."
  cron_upsert_agent_job \
    "qa-nightly" \
    "30 21 * * *" \
    "qa" \
    "900" \
    "none" \
    "QA routine: run jobhunter_audit_email_extraction({days:7, threshold:0.5, min_expected:3, unmark:true}). Then follow skills/qa/SKILL.md DB Anti-Pattern Checklist exactly with SELECT-only SQL: stuck_picked_task, repeated_source_failures, placeholder_titles, stale_unparsed_email_alerts, failure_reports, digest_volume_drop. For every non-empty SELECT result, file one jobhunter_file_task to Engineer with kind qa.bug and payload fields anti_pattern, sample_ids, observed, expected, repro_steps. Complete one qa.investigate task if present, write jobhunter_write_status_report, and stay silent on Telegram."
  cron_upsert_agent_job \
    "engineer-nightly" \
    "0 20 * * *" \
    "engineer" \
    "3600" \
    "none" \
    "Engineer routine. STEP 0: Run \`cd /workspace && pwd && git log --oneline -1\`. pwd MUST print /workspace; git log MUST show a recent jobhunter commit (e.g. 'Phase 7 pre-merge polish' or newer). If not, the workspace is misconfigured - complete the task with status=needs_clarification explaining the cwd mismatch and STOP. STEP 1: pick the highest-priority open task via jobhunter_pick_task(agent='engineer'). STEP 2: read the task's payload_json carefully - it contains 'problem', 'proposed_solution', 'files_to_touch', 'acceptance', 'do_not_do'. STEP 3: \`git fetch origin && git checkout -B engineer/<task-id>-<slug> origin/main\`. STEP 4: edit files per the solution. STEP 5: run \`PYTHONPYCACHEPREFIX=/tmp/pycache python3 -m unittest discover -s tests\` and iterate until passing. STEP 6: \`git add -A && git commit -m '<task-id>: <summary>' && git push -u origin engineer/<task-id>-<slug>\`. STEP 7: \`gh pr create --title '...' --body '...'\` referencing the task acceptance criteria; capture the printed PR URL. STEP 8: jobhunter_complete_task(task_id, status='completed', result={'pr_url': '<url>', 'tests_passing': true}). Never push or merge main. If gh auth fails OR any step blocks, complete the task with status='needs_clarification' and a clear note about what blocked you. Do not exit silently after planning - either complete all 8 steps or explicitly mark needs_clarification."
  cron_upsert_agent_job \
    "pm-stakeholder" \
    "30 22 * * *" \
    "pm" \
    "1200" \
    "telegram" \
    "PM daily routine: call jobhunter_rescore_recent_jobs(limit=500) first to incorporate any overnight scoring updates, then read goals/profile/ICP/KPIs/reports/tasks, make only audited reversible direct edits when evidence is concrete, file tasks/proposals as needed, write jobhunter_write_status_report, then send exactly one Telegram stakeholder report. Do not chase replies."
}

